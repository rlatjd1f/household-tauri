{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Household Manager",
  "version": "0.1.4",
  "identifier": "com.household.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Household Manager",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNzY4RjAyMzc1OTE2OTgKUldTWUZsazNBbzkyZ3dxTGhwaXFYeDFKUVNFSE1pbzFQWUJmQ0VxaVdBRVNBek5Ta1RDaVpIZ1UK",
      "endpoints": [
        "https://github.com/rlatjd1f/household-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
